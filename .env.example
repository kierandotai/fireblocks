# Optional. Without these the app runs in dry-run mode and shows the exact
# createTransaction request it would send.
FIREBLOCKS_API_KEY=
# PEM private key for the API user. Literal \n sequences are accepted.
FIREBLOCKS_SECRET_KEY=
FIREBLOCKS_AGENT_VAULT_ID=
# Testnet asset id in your sandbox workspace, e.g. USDC_TEST or a USDC test token id
FIREBLOCKS_ASSET_ID=USDC_TEST
# Defaults to the Fireblocks sandbox
FIREBLOCKS_BASE_PATH=https://sandbox-api.fireblocks.io/v1
